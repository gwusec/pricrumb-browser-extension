{
  "manifest_version": 2,
  "name": "Cookie Checker3",
  "version": "1.1",
  "permissions": [
    "cookies",
    "history",
    "activeTab",
    "storage",
    "downloads",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "browser-polyfill.min.js",
      "background.js",
      "models.js"
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js", "tracking.js"]
    }
  ],
  "web_accessible_resources": [
    "pricrumbs_preferred_cookie_choices_functional.html",
    "pricrumbs_preferred_cookie_choices_performance.html",
    "pricrumbs_preferred_cookie_choices_advertising.html",
    "pricrumbs_consent_history_top_websites.html",
    "pricrumbs_consent_history_bottom_websites.html",
    "pricrumbs_website_all_cookies_accepted.html",
    "pricrumbs_website_all_cookies_rejected.html",
    "pricrumbs_website_advertising_cookies_rejected.html",
    "pricrumbs_website_all_cookies_default.html",
    "popup.html",
    "prefered_choices1.html",
    "prefered_choices2.html",
    "tcf_strings.json",
    "tcf_default_decoded_js.json",
    "tcf_no_store_before_interaction.json"
  ],
  "browser_action": {
    "default_title": "Cookie Checker3"
  }
}
