{
  "manifest_version": 3,
  "name": "Cookie Checker",
  "version": "1.0",
  "permissions": ["cookies", "activeTab", "storage", "downloads", "history", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
