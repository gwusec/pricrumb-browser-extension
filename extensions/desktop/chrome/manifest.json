{
  "manifest_version": 3,
  "name": "Cookie Checker",
  "version": "1.1",
  "permissions": ["cookies", "history", "activeTab", "storage", "downloads", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/"],
      "js": ["content.js"]
    }
  ],
  "action": {}
}